{
  "schema_version": "1.2",
  "graphify": {
    "enabled": true,
    "mode": "governed-adapter",
    "upstream": "https://github.com/Graphify-Labs/graphify",
    "package": "graphifyy",
    "version_pin": "0.9.67",
    "install_command": "python -m pip install graphifyy==0.9.67",
    "verify_command": "graphify --help",
    "outputs": [
      "graphify-out/graph.json",
      "graphify-out/graph.html",
      "graphify-out/GRAPH_REPORT.md"
    ],
    "mcp_allowed": true,
    "auto_watch": false,
    "git_hook_allowed": true,
    "policy": {
      "proprietary_code": "local-ast-first",
      "documents_and_images": "external-llm-only-after-policy-approval",
      "provenance_required": true
    }
  },
  "agentswarms": {
    "enabled": true,
    "role": "internal-governed-workbench",
    "authoritative_control_plane": false,
    "upstream": "https://github.com/AgentSwarms-fyi/agentswarms",
    "pinned_commit": "95179372d0c4dd72b300639a7a17556beca8651e",
    "upstream_version": "1.5.0",
    "license": "Elastic-2.0",
    "hosted_third_party_service_allowed": false,
    "preserve_notices": true,
    "backend_policy": "dedicated-supabase-project-required",
    "runtime_policy": "isolated-service",
    "routing_parent": "OmegaOmniRoute",
    "governance_parent": [
      "OmegaMissionControl",
      "PEA",
      "OmegaCSF"
    ],
    "consequential_actions": "human-approval-required",
    "status_endpoint": "/status",
    "runtime_state": "quarantined",
    "runtime_exposure_allowed": false,
    "quarantine_reason": "Production dependency audit retains High vulnerabilities after safe hardening attempts; upstream application must not be exposed until security gate and regression tests pass.",
    "fallback_adapter": "pefy/skills/agentswarms/SKILL.md",
    "security_gate": {
      "critical_max": 0,
      "high_max": 0,
      "typecheck_required": true,
      "tests_required": true,
      "dedicated_supabase_required": true
    }
  },
  "free_ai_fabric": {
    "enabled": true,
    "strategy": "local-first-then-authorized-free-tier",
    "providers": [
      "ollama",
      "llama.cpp",
      "vllm",
      "gemini-free",
      "groq-free",
      "openrouter-free",
      "huggingface-free"
    ],
    "secret_values_in_repo": false,
    "premium_fallback": [
      "openai",
      "nvidia",
      "google",
      "anthropic"
    ],
    "route_dimensions": [
      "privacy",
      "risk",
      "quality",
      "latency",
      "quota",
      "context",
      "tool_calling",
      "modality",
      "cost",
      "availability"
    ]
  },
  "dark_forest_safeguards": {
    "enabled": true,
    "governance_parent": [
      "OmegaCSF",
      "GARKAEL"
    ],
    "mode": "defensive-reference-profile",
    "source": "https://github.com/slowmist/Blockchain-dark-forest-selfguard-handbook",
    "principles": [
      "zero-trust",
      "continuous-security-validation",
      "segregation",
      "stop-loss-first",
      "preserve-evidence"
    ]
  }
}
