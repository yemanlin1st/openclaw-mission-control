FROM node:22-bookworm-slim

ARG AGENTSWARMS_COMMIT=95179372d0c4dd72b300639a7a17556beca8651e
ARG GRAPHIFY_VERSION=0.9.67

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH \
    AGENTSWARMS_HOME=/opt/agentswarms \
    AGENTSWARMS_COMMIT=$AGENTSWARMS_COMMIT \
    GRAPHIFY_VERSION=$GRAPHIFY_VERSION \
    PORT=8080

RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates python3 python3-venv \
 && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/venv \
 && /opt/venv/bin/python -m pip install --no-cache-dir --upgrade pip \
 && /opt/venv/bin/python -m pip install --no-cache-dir "graphifyy==${GRAPHIFY_VERSION}" \
 && graphify --help >/dev/null

RUN git clone --filter=blob:none https://github.com/AgentSwarms-fyi/agentswarms.git /opt/agentswarms \
 && cd /opt/agentswarms \
 && git fetch --depth 1 origin "$AGENTSWARMS_COMMIT" \
 && git checkout --detach "$AGENTSWARMS_COMMIT" \
 && npm ci \
 && (npm audit fix --package-lock-only --omit=dev || true) \
 && npm pkg set "dependencies.nodemailer=10.0.10" \
                "dependencies.pdfjs-dist=4.10.38" \
                "dependencies.pptxgenjs=4.0.0" \
                "overrides.tar=7.5.22" \
 && npm install \
 && npm run typecheck \
 && npm test \
 && node -e "const p=require('./package.json'); if(p.name!=='agentswarms') process.exit(2); console.log('AgentSwarms '+p.version+' hardened overlay installed and regression checks passed')"

RUN mkdir -p /opt/pefy \
 && cd /opt/agentswarms \
 && (npm audit --omit=dev --json > /opt/pefy/agentswarms-npm-audit-prod.json || true)

COPY pefy/runtime/health_server.py /opt/pefy/health_server.py
COPY pefy/runtime/fixture.py /opt/pefy/fixture.py

EXPOSE 8080
CMD ["python3", "/opt/pefy/health_server.py"]
